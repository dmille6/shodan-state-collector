# Secrets / config — never commit
.env

# The archive: sensitive third-party exposure data, large, irreplaceable.
# Keep it out of git entirely. Back it up out-of-band instead.
daily_downloads/

# Python virtualenv (rebuildable from requirements.txt)
venv/
__pycache__/
*.pyc

# Generated triage reports — list named orgs and their weaknesses (FOUO).
reports/
# Compromise tripwire hits — named orgs flagged by Shodan as compromised (FOUO),
# same sensitivity as daily_downloads. Never commit; back up out-of-band.
compromise_hits/
# Refreshable public enrichment caches (KEV/EPSS) — not worth versioning.
reference/
# Derived analytical store (Parquet + DuckDB) — rebuildable from daily_downloads,
# and contains the same sensitive named-org data. Never commit.
store/

# Logs
*.log

# Any stray Shodan credential files
*api_key*
.config/

# MaxMind GeoIP databases (licensed, large)
*.mmdb
geoip*.tar.gz

# Runtime bookkeeping (per-day collector exit codes, pipeline lock)
status/
.pipeline.lock

# Phase 2 — the CURATED registry inputs are versioned (they are the product);
# everything generated, cached or sensitive under reference/ stays ignored.
!reference/
reference/*                            # ignore everything under reference/ ...
!reference/registry/                   # ... except the registry inputs
reference/registry/*
!reference/registry/orgs.csv
!reference/registry/networks.csv
!reference/registry/domains.csv
!reference/registry/ots_cidrs.csv.example
!reference/rosters/
reference/rosters/*
!reference/rosters/manual/             # hand-maintained drop-ins
reference/rosters/manual/cache/
reports/packets/                       # notification packets (FOUO)
